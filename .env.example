# =============================================================================
# NebulaOS - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# On Windows: copy .env.example .env
# On Linux/Mac: cp .env.example .env

# --- API Server ---
PORT=8000
HOST=0.0.0.0
API_VERSION=v14.2-prod-hardened

# --- Database ---
DATABASE_URL=postgres://nebula:password123@localhost:5432/nebula?sslmode=disable

# --- Message Broker ---
NATS_URL=nats://localhost:4222

# --- Identity & Auth ---
# Set USE_KEYCLOAK=true to use Keycloak; omit or false for internal JWT auth
USE_KEYCLOAK=false
KC_URL=http://localhost:8080
KC_CLIENT_ID=nebula-api
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin
JWT_SECRET=nebula-secret-key-2026

# --- Vault (Secrets Management) ---
VAULT_URL=http://localhost:8200
VAULT_TOKEN=root-token

# --- Provider Credentials ---
# Proxmox
PROXMOX_URL=https://pve.nebula.local/api2/json
PROXMOX_TOKEN=token-uuid

# OpenStack
OS_IDENTITY_ENDPOINT=http://openstack:5000/v3
OS_USERNAME=admin
OS_PASSWORD=password

# BareMetal (IPMI)
BM_IPMI_USER=admin
BM_IPMI_PASSWORD=password

# AWS / Moto (local AWS mock)
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566

# Kubernetes
KUBECONFIG_PATH=kubeconfig-data

# Traefik
TRAEFIK_CONFIG_DIR=./configs/traefik
TRAEFIK_CERT_RESOLVER=le

# --- CORS ---
CORS_ALLOWED_ORIGIN=*

# --- Seed Data (IDs for default tenant/org/project) ---
SEED_TENANT_ID=v-t1
SEED_TENANT_NAME=Nebula Global Corp
SEED_ORG_ID=org-nebula-main
SEED_ORG_NAME=Nebula Global Corp
SEED_DEPT_ID=dept-core-infra
SEED_DEPT_NAME=Core Infrastructure
SEED_PROJECT_ID=v-p1
SEED_PROJECT_NAME=Nebula Core Project
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin
SEED_ADMIN_EMAIL=admin@nebula.local
SEED_ADMIN_ID=u-admin
SEED_RESOURCE_NODE_ID=v-n1
SEED_RESOURCE_VOL_ID=v-s1
SEED_VOLUME_ID=v-vol-1
SEED_BUCKET_ID=v-b1
SEED_BUCKET_REGION=us-east-1
SEED_REGION_US_ID=reg-us-east
SEED_REGION_US_NAME=US East (Proxmox Cluster A)
SEED_REGION_US_LOCATION=Virginia
SEED_REGION_EU_ID=reg-eu-west
SEED_REGION_EU_NAME=EU West (OpenStack Lab)
SEED_REGION_EU_LOCATION=London
SEED_ZONE_ID=zone-a
SEED_ZONE_NAME=Zone A
SEED_PROVIDER_PX_ID=prov-px-1
SEED_PROVIDER_OS_ID=prov-os-1

# --- Frontend (Vite) ---
# These are consumed by the Vite dev server / build
VITE_API_URL=http://localhost:8000
VITE_AUTH_STORAGE_KEY=nebula_token
VITE_DEFAULT_PROJECT_ID=v-p1
VITE_NEBULA_API_DOMAIN=api.nebula.local

# --- Docker Compose (Infrastructure) ---
# PostgreSQL
POSTGRES_DB=nebula
POSTGRES_USER=nebula
POSTGRES_PASSWORD=password123

# Keycloak (Docker)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# Vault (Docker)
VAULT_DEV_ROOT_TOKEN_ID=root

# DNS / Domains
NEBULA_DOMAIN=nebula.local
NEBULA_API_DOMAIN=api.nebula.local
NEBULA_DASHBOARD_PORT=80
NEBULA_API_PORT=8000

# BareMetal Provider (SSH + IPMI)
BM_SSH_HOST=hypervisor.nebula.local
BM_SSH_USER=root
BM_SSH_KEY_PATH=
BM_SSH_PASSWORD=
BM_IPMI_USER=admin
BM_IPMI_PASSWORD=password

# Traefik
TRAEFIK_LOG_LEVEL=DEBUG
TRAEFIK_ENTRYPOINT_PORT=80
